# Copy this file to .env.local. The Agent uses simulation mode while the key is empty.
OPENAI_COMPATIBLE_IMAGE_API_KEY=
OPENAI_COMPATIBLE_IMAGE_BASE_URL=https://api.openai.com
OPENAI_COMPATIBLE_IMAGE_MODEL=gpt-image-2

# Stage 4: one local ComfyUI API workflow. Keep the path empty for simulation mode.
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_PATH=
COMFYUI_PROMPT_NODE_ID=6
COMFYUI_PROMPT_INPUT=text
COMFYUI_OUTPUT_NODE_ID=
COMFYUI_ALLOW_SIMULATION=true
COMFYUI_TIMEOUT_MS=120000
